# Dawa Tech Environment Configuration

PROJECT_NAME="Dawa Tech"
ENV="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security
SECRET_KEY="super-secret-dawa-tech-dev-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="dawatech"
POSTGRES_PASSWORD="dawatech_password"
POSTGRES_DB="dawatech_db"
DATABASE_URL="postgresql+asyncpg://dawatech:dawatech_password@localhost:5432/dawatech_db"
SYNC_DATABASE_URL="postgresql+psycopg2://dawatech:dawatech_password@localhost:5432/dawatech_db"

# Initial Admin Seeding
FIRST_SUPERUSER_EMAIL="admin@dawatech.com"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"
FIRST_SUPERUSER_PHONE="+201000000001"
FIRST_SUPERUSER_NAME="مدير المنصة"

# OTP Settings
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Rate Limiting
RATE_LIMIT_ENABLED=True

# CORS
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]'
